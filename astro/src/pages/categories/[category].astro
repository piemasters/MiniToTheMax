---
import GroupPage from '../../components/GroupPage.astro';
import { getGroupPages, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const pages = await getGroupPages('categories');
  return pages.map(({ slug, name, posts }) => ({
    params: { category: slug },
    props: { name, posts },
  }));
}

interface Props {
  name: string;
  posts: Post[];
}
---

<GroupPage field="categories" {...Astro.props} />
