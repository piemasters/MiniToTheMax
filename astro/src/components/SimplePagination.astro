---
import { slugOf, type Post } from '../lib/posts';

interface Props {
  previous?: Post;
  next?: Post;
}

const { previous, next } = Astro.props;
const linkClass =
  'h-full text-blue-500 visited:text-blue-500 hover:text-blue-700';
const boxClass =
  'flex items-center h-full max-w-full px-4 py-8 bg-neutral-50 hover:bg-neutral-100';
---

<div
  data-testid="simple-pagination"
  class="grid grid-cols-1 gap-4 py-4 no-underline list-none md:grid-cols-2 auto-rows-fr"
>
  {
    next && (
      <a href={slugOf(next)} class={linkClass}>
        <div class:list={[boxClass, 'justify-start']}>
          <div class="pr-4">←</div>
          <div>{next.data.title}</div>
        </div>
      </a>
    )
  }
  {
    previous && (
      <a href={slugOf(previous)} class={linkClass}>
        <div class:list={[boxClass, 'justify-end']}>
          <div>{previous.data.title}</div>
          <div class="pl-4">→</div>
        </div>
      </a>
    )
  }
</div>
