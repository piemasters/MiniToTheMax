---
import logo from '../../../content/assets/images/logo.webp';
import { navLinks, site } from '../lib/site';

const trim = (path: string) => path.replace(/\/+$/, '') || '/';
const path = trim(Astro.url.pathname);

/** A section stays highlighted on the pages beneath it. */
const isActive = (url: string) =>
  url === '/' ? path === '/' : path === url || path.startsWith(`${url}/`);
---

<nav class="p-2 mb-8 bg-gray-100 md:p-4" data-testid="nav-header">
  <div class="flex flex-col max-w-3xl mx-auto">
    <a href="/" class="flex items-center py-2 mb-2 text-gray-900 no-underline">
      <img src={logo.src} alt="Logo" height="60" width="60" />
      <h1 class="mb-0! pl-4! text-2xl! md:text-3xl! lg:text-4xl!">
        {site.title}
      </h1>
    </a>

    <div class="flex gap-2 m-0 list-none md:gap-4 md:pl-12">
      {
        navLinks.map(({ name, url }) => (
          <a
            href={url}
            aria-current={path === url ? 'page' : undefined}
            class:list={[
              'p-1 text-sm font-bold text-gray-600 no-underline md:p-2 lg:p-2 md:text-md hover:text-red-700',
              { 'text-red-700!': isActive(url) },
            ]}
          >
            {name}
          </a>
        ))
      }
    </div>
  </div>
</nav>
