---
import battleReports from '../../../content/assets/images/battle-reports-badge.webp';
import reviews from '../../../content/assets/images/reviews-badge.webp';
import showcase from '../../../content/assets/images/showcase-badge.webp';
import tutorials from '../../../content/assets/images/tutorials-badge.webp';

const badges = [
  { name: 'showcase', url: '/showcase', image: showcase },
  { name: 'tutorials', url: '/tutorials', image: tutorials },
  { name: 'reviews', url: '/reviews', image: reviews },
  { name: 'battle Reports', url: '/battle-reports', image: battleReports },
];
---

<div class="flex flex-row flex-wrap justify-center" data-testid="badges">
  {
    badges.map(({ name, url, image }) => (
      <a href={url} class="flex flex-col no-underline opacity-90 hover:opacity-100">
        <div class="flex flex-col justify-end w-36" data-testid="badge">
          <img
            src={image.src}
            height="120"
            width="120"
            alt=""
            class="mx-auto mb-2 opacity-90 hover:opacity-100"
            fetchpriority="high"
          />
          <p class="text-center capitalize">{name}</p>
        </div>
      </a>
    ))
  }
</div>
