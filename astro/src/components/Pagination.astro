---
import { getPages } from '../../../src/components/Pagination/getPages';

interface Props {
  numPages: number;
  currentPage: number;
  baseUrl: string;
}

const { numPages, currentPage, baseUrl } = Astro.props;
const pages = getPages({ numPages, maxPages: 8, currentPage });
const href = (page: number) => `${baseUrl}${page === 1 ? '' : page}`;
const linkClass =
  'rounded no-underline text-blue-500 hover:bg-blue-500! hover:text-white';
const ends = [
  { label: '<<', name: 'First page', page: 1 },
  { label: '>>', name: 'Last page', page: numPages },
] as const;
---

<ul
  class="flex flex-wrap items-center justify-between p-0 my-8"
  data-testid="pagination"
>
  {
    [ends[0], null, ends[1]].map((end) =>
      end ? (
        <li class="list-none!">
          {end.page === currentPage ? (
            <div class="text-gray-700">{end.label}</div>
          ) : (
            <a
              href={href(end.page)}
              aria-label={end.name}
              class:list={['p-2', linkClass]}
            >
              {end.label}
            </a>
          )}
        </li>
      ) : (
        pages.map((page) => (
          <li class="list-none!">
            <a
              href={href(page)}
              aria-current={page === currentPage ? 'page' : undefined}
              class:list={[
                'py-2 px-3',
                linkClass,
                { 'bg-blue-500! text-white': page === currentPage },
              ]}
            >
              {page}
            </a>
          </li>
        ))
      )
    )
  }
</ul>
