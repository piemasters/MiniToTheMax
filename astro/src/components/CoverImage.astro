---
import { Image } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  title: string;
  tall?: boolean;
  /** Loads straight away: for the image at the top of a page. */
  priority?: boolean;
}

const { image, title, tall = false, priority = false } = Astro.props;
---

<div class="relative" data-testid="cover-image">
  <Image
    src={image}
    alt={title}
    layout="constrained"
    width={Math.min(image.width, 750)}
    priority={priority}
    class="w-full h-auto"
  />
  <h2
    class:list={[
      'px-4! py-1! absolute right-4 text-lg! bg-black/70 text-gray-200!',
      tall ? 'bottom-5' : 'bottom-0',
    ]}
  >
    {title}
  </h2>
</div>
