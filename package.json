{
  "name": "minitothemax",
  "private": true,
  "description": "Website for MiniToTheMax",
  "version": "1.0.1",
  "license": "MIT",
  "engines": {
    "node": ">=24.11.0 <26"
  },
  "scripts": {
    "dev": "ALL_POSTS=1 astro dev",
    "dev-lite": "ALL_POSTS= astro dev",
    "dev-unpublished": "ALL_POSTS=1 UNPUBLISHED_ONLY=1 astro dev",
    "start": "yarn dev",
    "build": "ALL_POSTS=1 astro build",
    "build:sample": "astro build",
    "preview": "astro preview",
    "optimize": "node ./scripts/optimize.js",
    "format": "prettier --write \"**/*.{js,jsx,tsx,json,md}\"",
    "test": "jest",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test:e2e": "start-server-and-test dev-lite http://localhost:4321 cy:open",
    "test:e2e:ci": "start-server-and-test dev-lite http://localhost:4321 cy:run",
    "type-check": "astro sync && tsc --noEmit",
    "lint": "eslint .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.6",
    "@astrojs/react": "7.1.9",
    "@astrojs/sitemap": "3.7.6",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.13",
    "disqus-react": "1.1.7",
    "lodash.kebabcase": "4.1.1",
    "photoswipe": "5.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-photoswipe-gallery": "4.1.2",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.6.0",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "10.6.9",
    "@storybook/addon-docs": "10.6.9",
    "@storybook/addon-links": "10.6.9",
    "@storybook/react-vite": "10.6.9",
    "@swc/core": "1.16.22",
    "@swc/jest": "0.2.39",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/cypress": "10.1.3",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@types/jest": "30.0.0",
    "@types/lodash.kebabcase": "4.1.9",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "axe-core": "4.14.1",
    "cypress": "16.3.0",
    "cypress-axe": "1.7.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-storybook": "10.6.9",
    "fs-extra": "11.4.1",
    "glob": "14.0.6",
    "globals": "17.14.0",
    "identity-obj-proxy": "3.0.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "start-server-and-test": "3.0.13",
    "storybook": "10.6.9",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "8.3.8"
  }
}
