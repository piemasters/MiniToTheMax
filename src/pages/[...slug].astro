---
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import { CoverImage } from '../components/CoverImage/CoverImage';
import { Gallery } from '../components/Gallery/Gallery';
import { PostTag } from '../components/PostTag/PostTag';
import { SimplePagination } from '../components/SimplePagination/SimplePagination';
import { Comments } from '../components/Comments/Comments';
import Layout from '../layouts/Layout.astro';
import { coverImage } from '../lib/images';
import { excerptOf, getPosts, slugOf, type Post } from '../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, previous: posts[index + 1], next: posts[index - 1] },
  }));
}

interface Props {
  post: Post;
  previous?: Post;
  next?: Post;
}

const { post, previous, next } = Astro.props;
const { title, date, categories, tags, featuredImage, gallery } = post.data;
const { Content } = await render(post);

const images = await Promise.all(
  (gallery ?? []).map(async (source) => {
    const width = Math.min(source.width, 1800);
    // Twice the displayed size, for high density screens
    const [thumb, full] = await Promise.all([
      getImage({ src: source, width: 338, height: 338, fit: 'cover' }),
      getImage({ src: source, width }),
    ]);
    return {
      thumb: thumb.src,
      full: full.src,
      width,
      height: Math.round((source.height * width) / source.width),
    };
  })
);

const cover = await coverImage(featuredImage);
const link = (other?: Post) =>
  other && { slug: slugOf(other), title: other.data.title };
const disqus = import.meta.env.DISQUS_NAME || 'disqusShortname';
---

<Layout
  title={title}
  description={excerptOf(post)}
  image={featuredImage.src}
  article
>
  <CoverImage image={cover} title={title} priority />
  <div class="py-2">
    {categories.map((name) => <PostTag type="categories" name={name} />)}
    {tags.map((name) => <PostTag type="tags" name={name} />)}
  </div>
  <div class="px-2 py-4 text-sm text-right">
    <strong>Published</strong>{' '}
    {date}
  </div>
  <div class="post-body"><Content /></div>
  {
    images.length > 0 && (
      <div>
        <h2>Gallery</h2>
        <Gallery gallery={images} client:visible />
      </div>
    )
  }
  <SimplePagination previous={link(previous)} next={link(next)} />
  <hr />
  <Comments
    client:visible
    shortname={disqus}
    identifier={slugOf(post)}
    title={title}
    url={`${Astro.site?.origin}/${slugOf(post)}`}
  />
</Layout>
